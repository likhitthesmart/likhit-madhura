# Deployed API (Render — see render.yaml). The browser always calls same-origin
# /api/v1, which next.config.ts rewrites here; SSR fetches hit it directly
# (src/lib/api.ts:2). Unset, both fall back to 127.0.0.1:4000 and Vercel rejects
# it as a private address.
# Replace if Render assigns a different hostname than madhura-api.onrender.com.
API_URL=https://madhura-api.onrender.com
