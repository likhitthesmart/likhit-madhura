# ── Copy to .env (root, used by docker-compose) ─────────────────────────
DB_PASSWORD=change_me_strong

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_64_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_64_chars_min

# Public site URL (SEO, emails, sitemap)
SITE_URL=https://madhuraorganics.com

# Payments: mock | razorpay | stripe | phonepe | cashfree
PAYMENT_PROVIDER=mock

# SMTP (leave empty to log emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Madhura Organics <hello@madhuraorganics.com>"

# Cloudinary (optional — admin media uploads; local /public/media used otherwise)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Analytics integrations (optional, script tags render only when set)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
