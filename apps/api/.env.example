# Neon (pooled connection string from the Neon console)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
PORT=4000
JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
SITE_URL=http://localhost:3000
# mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Google sign-in — OAuth "Web application" credentials. Register the redirect URI
# $SITE_URL/api/v1/auth/google/callback in the Google console, exactly.
# In dev SITE_URL must match the port the web app serves on (3100), not the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587, SMTP_PASS = a 16-char App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Madhura Organics <hello@madhuraorganics.com>"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
